# ============================================================================
# postgui.hal — Direct MPG routing (no compound-slide dependency)
#
# Simplified version: routes MPG encoder counts directly to joints.
# The compound-slide mux feature is disabled until the Python GUI HAL
# component creation (hal.component) is confirmed working.
#
# MPG jog scale is fixed at 0.001"/click by default; the GUI can still
# change it via live_backend.set_mpg_scale_index() once compound-slide
# is re-enabled.
# ============================================================================

# --- MPG counts → joint jog-counts (direct, no mux) ---
net mpg-x-counts  =>  joint.0.jog-counts  axis.x.jog-counts
net mpg-z-counts  =>  joint.1.jog-counts  axis.z.jog-counts

# --- MPG scale: 0.001"/click (mux4 index 1: sel0=1, sel1=0) ---
setp mux4.jogscale-x.sel0  1
setp mux4.jogscale-x.sel1  0
setp mux4.jogscale-z.sel0  1
setp mux4.jogscale-z.sel1  0
