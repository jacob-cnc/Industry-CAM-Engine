%

; Industry CAM Engine - Generated Program
; Profile: 3 segments, Mode: OD
; Stock: 1.0000 dia, Z 0.1000 to -1.0000
; DOC: 0.0500 dia, Rough Feed: 0.0060
; Fin Allowance: 0.0050 dia, Finish Feed: 0.0030
; RPM: 1200
; Tool: T99 Default T99 CNMG

N10 G20 G18 G40 G49 G80  ; Safety line - inch, ZX plane, comp off
N20 G90 G95  ; Absolute positioning, feed per revolution

N30 S1200 M3  ; Spindle CW - enables encoder for feed/rev
N40 G00 X2.0000 Z2.0000  ; Move to park position

N50 T99 M6  ; Load tool T99 - Default T99 CNMG
N60 G43  ; Tool length comp on
N70 G40  ; Cutter comp off - requires tool radius in tool table to enable

; === FACE PASSES (4 passes) ===
N80 G00 X1.0100 Z0.1000  ; Approach: Stock OD, Z_start
N90 G01 X1.0100 Z0.0750 F0.0060  ; Face pass 1: feed Z to 0.0750
N100 G01 X1.0000 Z0.0750  ; Face pass 1: feed to X_start
N110 G01 X0.0000 Z0.0750  ; Face pass 1: feed to X_start
N120 G00 X1.0100 Z0.1000  ; Retract X to stock OD, Z=0.1000 (prev pass)
N130 G01 X1.0100 Z0.0500  ; Face pass 2: feed Z to 0.0500
N140 G01 X1.0000 Z0.0500  ; Face pass 2: feed to X_start
N150 G01 X0.0000 Z0.0500  ; Face pass 2: feed to X_start
N160 G00 X1.0100 Z0.0750  ; Retract X to stock OD, Z=0.0750 (prev pass)
N170 G01 X1.0100 Z0.0250  ; Face pass 3: feed Z to 0.0250
N180 G01 X1.0000 Z0.0250  ; Face pass 3: feed to X_start
N190 G01 X0.0000 Z0.0250  ; Face pass 3: feed to X_start
N200 G00 X1.0100 Z0.0500  ; Retract X to stock OD, Z=0.0500 (prev pass)
N210 G01 X1.0100 Z0.0025  ; Face pass 4: feed Z to 0.0025
N220 G01 X1.0000 Z0.0025  ; Face pass 4: feed to X_start
N230 G01 X0.0000 Z0.0025  ; Face pass 4: feed to X_start
N240 G00 X1.0100 Z0.0250  ; Retract X to stock OD, Z=0.0250 (prev pass)

; === ROUGHING PASSES (9 passes) ===
N250 G00 X1.0100 Z0.0025  ; Rough pass 1: traverse Z to 0.0025 at X1.0100
N260 G01 X0.9500 Z0.0025  ; Rough pass 1: feed X to DOC level 0.9500
N270 G01 X0.9500 Z-1.0000  ; Rough pass 1 cut
N280 G00 X1.0100 Z-1.0000  ; Retract X to prev pass level 1.0100
N290 G00 X0.9500 Z0.0025  ; Rough pass 2: traverse Z to 0.0025 at X0.9500
N300 G01 X0.9000 Z0.0025  ; Rough pass 2: feed X to DOC level 0.9000
N310 G01 X0.9000 Z-1.0000  ; Rough pass 2 cut
N320 G00 X0.9500 Z-1.0000  ; Retract X to prev pass level 0.9500
N330 G00 X0.9000 Z0.0025  ; Rough pass 3: traverse Z to 0.0025 at X0.9000
N340 G01 X0.8500 Z0.0025  ; Rough pass 3: feed X to DOC level 0.8500
N350 G01 X0.8500 Z-1.0000  ; Rough pass 3 cut
N360 G00 X0.9000 Z-1.0000  ; Retract X to prev pass level 0.9000
N370 G00 X0.8500 Z0.0025  ; Rough pass 4: traverse Z to 0.0025 at X0.8500
N380 G01 X0.8000 Z0.0025  ; Rough pass 4: feed X to DOC level 0.8000
N390 G01 X0.8000 Z-1.0000  ; Rough pass 4 cut
N400 G00 X0.8500 Z-1.0000  ; Retract X to prev pass level 0.8500
N410 G00 X0.8000 Z0.0025  ; Rough pass 5: traverse Z to 0.0025 at X0.8000
N420 G01 X0.7500 Z0.0025  ; Rough pass 5: feed X to DOC level 0.7500
N430 G01 X0.7500 Z-1.0000  ; Rough pass 5 cut
N440 G00 X0.8000 Z-1.0000  ; Retract X to prev pass level 0.8000
N450 G00 X0.7500 Z0.0025  ; Rough pass 6: traverse Z to 0.0025 at X0.7500
N460 G01 X0.7000 Z0.0025  ; Rough pass 6: feed X to DOC level 0.7000
N470 G01 X0.7000 Z-1.0000  ; Rough pass 6 cut
N480 G00 X0.7500 Z-1.0000  ; Retract X to prev pass level 0.7500
N490 G00 X0.7000 Z0.0025  ; Rough pass 7: traverse Z to 0.0025 at X0.7000
N500 G01 X0.6500 Z0.0025  ; Rough pass 7: feed X to DOC level 0.6500
N510 G01 X0.6500 Z-1.0000  ; Rough pass 7 cut
N520 G00 X0.7000 Z-1.0000  ; Retract X to prev pass level 0.7000
N530 G00 X0.6500 Z0.0025  ; Rough pass 8: traverse Z to 0.0025 at X0.6500
N540 G01 X0.6000 Z0.0025  ; Rough pass 8: feed X to DOC level 0.6000
N550 G01 X0.6000 Z-1.0000  ; Rough pass 8 cut
N560 G00 X0.6500 Z-1.0000  ; Retract X to prev pass level 0.6500
N570 G00 X0.6000 Z0.0025  ; Rough pass 9: traverse Z to 0.0025 at X0.6000
N580 G01 X0.5500 Z0.0025  ; Rough pass 9: feed X to DOC level 0.5500
N590 G01 X0.5500 Z-1.0000  ; Rough pass 9 cut
N600 G00 X0.6000 Z-1.0000  ; Retract X to prev pass level 0.6000

; === CLEANUP PASS (semi-finish, roughing boundary contour) ===
N610 G00 X1.0100 Z0.0025  ; Rapid to stock OD at Z0+fin
N620 G00 X0.0050 Z0.0025  ; Rapid to X_start+fin=0.0050
N630 G01 X0.5050 Z0.0025  ; Cleanup move 1
N640 G01 X0.5050 Z-1.0000  ; Cleanup move 2
N650 G00 X1.0100 Z-1.0000  ; Retract X after cleanup
N660 G00 X1.0100 Z0.1000  ; Traverse Z to Z_start

; === FINISH PASS (profile contour) ===
N670 G00 X1.0100 Z0.0010  ; Rapid to stock OD at Z0+fin
N680 G00 X0.0000 Z0.0010  ; Rapid to X_start=0.0000
N690 G01 X0.0000 Z0.0000 F0.0030  ; Finish move 1
N700 G01 X0.5000 Z0.0000  ; Finish move 2
N710 G01 X0.5000 Z-1.0000  ; Finish move 3

; === PROGRAM END ===
N720 G40  ; Cutter comp cancel
N730 G00 X2.0000 Z2.0000  ; Return to park
N740 M5  ; Spindle stop
N750 M2  ; Program end
%
